@model CoursePlatform.ViewModels.CreateCourseViewModel

@{
    ViewData["Title"] = "Yeni Kurs Oluştur";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow-sm border-0 rounded-4">
                <div class="card-header bg-white border-bottom py-3">
                    <h5 class="mb-0 fw-bold text-dark"><i class="bi bi-journal-plus text-primary me-2"></i>Yeni Kurs Oluştur</h5>
                </div>
                <div class="card-body p-4">
                    <form asp-action="CreateCourse" method="post" enctype="multipart/form-data">
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                        <div class="mb-3">
                            <label asp-for="Title" class="form-label fw-medium text-dark"></label>
                            <input asp-for="Title" class="form-control" placeholder="Örn: Java ile Programlamaya Giriş" />
                            <span asp-validation-for="Title" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="CategoryId" class="form-label fw-medium text-dark"></label>
                            <select asp-for="CategoryId" class="form-select" asp-items="ViewBag.Categories"></select>
                            <span asp-validation-for="CategoryId" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Description" class="form-label fw-medium text-dark"></label>
                            <textarea asp-for="Description" class="form-control" rows="4" placeholder="Kurs hakkında öğrencilerinizi bilgilendirin..."></textarea>
                            <span asp-validation-for="Description" class="text-danger"></span>
                        </div>

                        <div class="mb-4">
                            <label asp-for="CoverImage" class="form-label fw-medium text-dark"></label>
                            <input asp-for="CoverImage" type="file" accept="image/*" class="form-control" />
                            <span asp-validation-for="CoverImage" class="text-danger"></span>
                        </div>

                        <div class="d-flex justify-content-between pt-2 border-top">
                            <a asp-action="Index" class="btn btn-outline-secondary">İptal</a>
                            <button type="submit" class="btn btn-primary px-4">Kursu Yayınla</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}