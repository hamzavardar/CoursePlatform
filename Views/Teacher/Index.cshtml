@model IEnumerable<CoursePlatform.Models.Course>

@{
    ViewData["Title"] = "Eğitmen Kurs Paneli";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2><i class="bi bi-journal-bookmark me-2"></i>Oluşturduğum Kurslar</h2>
        <a asp-action="CreateCourse" class="btn btn-primary">
            <i class="bi bi-plus-lg me-1"></i>Yeni Kurs Oluştur
        </a>
    </div>

    @if (!Model.Any())
    {
        <div class="alert alert-info">
            Henüz oluşturulmuş bir kursunuz bulunmamaktadır. Yeni bir kurs ekleyerek başlayabilirsiniz.
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover align-middle border">
                <thead class="table-dark">
                    <tr>
                        <th>Görsel</th>
                        <th>Kurs Başlığı</th>
                        <th>Kategori</th>
                        <th>Ders Sayısı</th>
                        <th>Öğrenci Sayısı</th>
                        <th>İşlemler</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>
                                @if (!string.IsNullOrEmpty(item.CoverImageUrl))
                                {
                                    <img src="@item.CoverImageUrl" alt="@item.Title" style="width: 60px; height: 40px; object-fit: cover;" class="rounded" />
                                }
                                else
                                {
                                    <span class="badge bg-secondary">Görsel Yok</span>
                                }
                            </td>
                            <td class="fw-bold">@item.Title</td>
                            <td>@item.Category?.Name</td>
                            <td><span class="badge bg-info text-dark">@item.Lessons.Count Ders</span></td>
                            <td><span class="badge bg-success">@item.Enrollments.Count Öğrenci</span></td>
                            <td>
                                <a asp-action="CourseDetails" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary me-1">
                                    <i class="bi bi-gear me-1"></i>Yönet & Dersler
                                </a>
                                <a asp-action="AddLesson" asp-route-courseId="@item.Id" class="btn btn-sm btn-success">
                                    <i class="bi bi-plus-circle me-1"></i>Video Ekle
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>