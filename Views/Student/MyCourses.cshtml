@model IEnumerable<CoursePlatform.Models.Course>

@{
    ViewData["Title"] = "Kayıtlı Kurslarım";
}

<div class="container py-4">
    <h2 class="mb-4"><i class="bi bi-book me-2"></i>Kayıtlı Kurslarım</h2>

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-warning">
            @TempData["ErrorMessage"]
        </div>
    }

    @if (!Model.Any())
    {
        <div class="alert alert-info">
            Henüz hiçbir kursa kayıt olmadınız. 
            <a asp-controller="Course" asp-action="Index" class="alert-link">Kurs kataloğuna göz atın.</a>
        </div>
    }
    else
    {
        <div class="row row-cols-1 row-cols-md-3 g-4">
            @foreach (var course in Model)
            {
                <div class="col">
                    <div class="card h-100 shadow-sm border-0">
                        @if (!string.IsNullOrEmpty(course.CoverImageUrl))
                        {
                            <img src="@course.CoverImageUrl" class="card-img-top" alt="@course.Title" style="height: 180px; object-fit: cover;">
                        }
                        else
                        {
                            <div class="bg-secondary text-white text-center py-5" style="height: 180px;">
                                <i class="bi bi-journal-code display-4"></i>
                            </div>
                        }

                        <div class="card-body d-flex flex-column">
                            <h5 class="card-title">@course.Title</h5>
                            <p class="card-text text-muted small mb-2">
                                Eğitmen: @course.Teacher?.FirstName @course.Teacher?.LastName
                            </p>
                            <p class="card-text small text-truncate">@course.Description</p>
                            
                            <div class="mt-auto pt-3">
                                <a asp-controller="Student" asp-action="Watch" asp-route-courseId="@course.Id" class="btn btn-primary w-100">
                                    <i class="bi bi-play-circle me-1"></i>Dersleri İzle
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>