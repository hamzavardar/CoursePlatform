@model CoursePlatform.ViewModels.CourseDetailViewModel

@{
    ViewData["Title"] = Model.Course.Title;
}

<div class="container py-4">
    <div class="row g-4">
        <!-- SOL TARAF: Kurs Bilgileri Kartı ve Müfredat -->
        <div class="col-lg-8">
            <div class="card border-0 shadow-sm rounded-4 p-4 bg-white mb-4">
                <div class="d-flex align-items-center gap-2 mb-3">
                    <span class="badge bg-primary-subtle text-primary border border-primary-subtle fs-6">@Model.Course.Category?.Name</span>
                    <span class="text-muted small">• Eğitmen: <strong>@Model.Course.Teacher?.FirstName @Model.Course.Teacher?.LastName</strong></span>
                </div>

                <h2 class="fw-bold text-dark mb-3">@Model.Course.Title</h2>

                @if (!string.IsNullOrEmpty(Model.Course.CoverImageUrl))
                {
                    <img src="@Model.Course.CoverImageUrl" class="img-fluid rounded-3 mb-4 w-100" style="max-height: 380px; object-fit: cover;" alt="@Model.Course.Title">
                }

                <h5 class="fw-bold text-dark mb-2">Kurs Hakkında</h5>
                <p class="text-secondary mb-0 style-description" style="line-height: 1.6;">
                    @(string.IsNullOrEmpty(Model.Course.Description) ? "Bu kurs için henüz açıklama eklenmedi." : Model.Course.Description)
                </p>
            </div>

            <!-- Ders İçeriği Liste Kartı -->
            <div class="card border-0 shadow-sm rounded-4 p-4 bg-white">
                <h5 class="fw-bold text-dark mb-3"><i class="bi bi-list-task text-primary me-2"></i>Ders İçeriği (@Model.Course.Lessons.Count Ders)</h5>
                
                @if (!Model.Course.Lessons.Any())
                {
                    <p class="text-muted mb-0">Bu kursta henüz yayınlanmış ders bulunmuyor.</p>
                }
                else
                {
                    <div class="d-flex flex-column gap-2">
                        @foreach (var lesson in Model.Course.Lessons)
                        {
                            <div class="d-flex align-items-center justify-content-between p-3 rounded-3 border bg-light-subtle">
                                <div class="d-flex align-items-center gap-3">
                                    <span class="badge bg-secondary rounded-pill px-3 py-2">#@lesson.Order</span>
                                    <div>
                                        <h6 class="fw-semibold text-dark mb-0">@lesson.Title</h6>
                                    </div>
                                </div>
                                <i class="bi bi-lock-fill text-muted"></i>
                            </div>
                        }
                    </div>
                }
            </div>
        </div>

        <!-- SAĞ TARAF: Kayıt Ol Kutusu -->
        <div class="col-lg-4">
            <div class="card border-0 shadow-sm rounded-4 p-4 bg-white sticky-top" style="top: 20px;">
                <div class="text-center mb-4">
                    <span class="badge bg-success-subtle text-success fs-5 px-3 py-2 rounded-pill">Tamamen Ücretsiz</span>
                </div>

                @if (User.Identity != null && User.Identity.IsAuthenticated)
                {
                    @if (User.IsInRole("Student"))
                    {
                        @if (Model.IsEnrolled)
                        {
                            <div class="alert alert-success text-center mb-3">
                                <i class="bi bi-check-circle-fill me-1"></i>Bu kursa kayıtlısınız.
                            </div>
                            <a asp-controller="Student" asp-action="Watch" asp-route-courseId="@Model.Course.Id" class="btn btn-primary w-100 btn-lg fs-6">
                                <i class="bi bi-play-circle me-1"></i>Dersleri İzlemeye Başla
                            </a>
                        }
                        else
                        {
                            <form asp-controller="Student" asp-action="Enroll" method="post">
                                <input type="hidden" name="courseId" value="@Model.Course.Id" />
                                <button type="submit" class="btn btn-success w-100 btn-lg fs-6">
                                    <i class="bi bi-plus-circle me-1"></i>Hemen Kaydol
                                </button>
                            </form>
                        }
                    }
                    else
                    {
                        <div class="alert alert-warning mb-0 text-center small">
                            Kurslara kayıt olabilmek için <strong>Öğrenci</strong> hesabı kullanmalısınız.
                        </div>
                    }
                }
                else
                {
                    <a asp-area="Identity" asp-page="/Account/Login" class="btn btn-primary w-100 btn-lg fs-6 mb-2">
                        Kayıt Olmak İçin Giriş Yap
                    </a>
                    <small class="text-muted text-center d-block">Hesabınız yok mu? <a asp-area="Identity" asp-page="/Account/Register">Kayıt Olun</a></small>
                }
            </div>
        </div>
    </div>
</div>