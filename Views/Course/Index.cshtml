@model IEnumerable<CoursePlatform.Models.Course>

@{
    ViewData["Title"] = "Tüm Kurslar";
    var categories = ViewBag.Categories as List<CoursePlatform.Models.Category> ?? new List<CoursePlatform.Models.Category>();
    int? currentCategory = ViewBag.CurrentCategory as int?;
    string searchString = ViewBag.SearchString as string ?? "";
}

<div class="container py-4">
    <!-- Üst Arama ve Filtreleme Alanı -->
    <div class="row justify-content-center mb-4">
        <div class="col-md-8 text-center">
            <h2 class="fw-bold text-dark mb-2">Kursları Keşfedin</h2>
            <p class="text-secondary mb-4">Kendinizi geliştirmek için yeni bir kurs keşfedin.</p>

            <!-- Arama Formu -->
            <form asp-controller="Course" asp-action="Index" method="get" class="d-flex gap-2 mb-4">
                @if (currentCategory.HasValue)
                {
                    <input type="hidden" name="categoryId" value="@currentCategory.Value" />
                }
                
                <div class="input-group shadow-sm rounded-3 overflow-hidden">
                    <input type="text" 
                           name="searchString" 
                           value="@searchString" 
                           class="form-control border-0 px-3 py-2" 
                           placeholder="Kurs adı veya açıklama ile ara..." />
                    
                    <button type="submit" class="btn btn-primary px-4" title="Ara">
                        <i class="bi bi-search"></i>
                    </button>

                    @if (!string.IsNullOrEmpty(searchString) || currentCategory.HasValue)
                    {
                        <a asp-action="Index" class="btn btn-outline-secondary d-flex align-items-center gap-1" title="Arama ve Filtreleri Sıfırla">
                            <i class="bi bi-x-circle-fill text-danger"></i>
                            <span>Sıfırla</span>
                        </a>
                    }
                </div>
            </form>

            <!-- Kategori Butonları (Arama kelimesinden bağımsız tüm kategoriyi getirir) -->
            <div class="d-flex flex-wrap justify-content-center gap-2">
                <a asp-action="Index" 
                   class="btn btn-sm @(!currentCategory.HasValue ? "btn-dark fw-bold" : "btn-outline-secondary") rounded-pill px-3 py-2">
                    Tümü
                </a>
                
                @foreach (var cat in categories)
                {
                    var isActive = currentCategory.HasValue && currentCategory.Value == cat.Id;
                    <a asp-action="Index" 
                       asp-route-categoryId="@cat.Id" 
                       class="btn btn-sm @(isActive ? "btn-dark fw-bold" : "btn-outline-secondary") rounded-pill px-3 py-2">
                        @cat.Name
                    </a>
                }
            </div>
        </div>
    </div>

    <!-- Kurs Listesi -->
    @if (!Model.Any())
    {
        <div class="card border-0 shadow-sm rounded-4 p-5 text-center my-4 bg-white">
            <i class="bi bi-search display-4 text-muted mb-3 opacity-50"></i>
            <h5 class="fw-bold text-dark mb-2">Aradığınız Kriterlere Uygun Kurs Bulunamadı</h5>
            <p class="text-secondary small mb-3">Farklı bir arama terimi deneyebilir veya filtreleri sıfırlayabilirsiniz.</p>
            <div>
                <a asp-action="Index" class="btn btn-primary btn-sm rounded-pill px-4">
                    <i class="bi bi-arrow-counterclockwise me-1"></i>Tüm Kursları Göster
                </a>
            </div>
        </div>
    }
    else
    {
        <div class="row row-cols-1 row-cols-md-3 g-4">
            @foreach (var course in Model)
            {
                <div class="col">
                    <div class="card h-100 border-0 shadow-sm rounded-4 overflow-hidden bg-white">
                        @if (!string.IsNullOrEmpty(course.CoverImageUrl))
                        {
                            <img src="@course.CoverImageUrl" class="card-img-top" alt="@course.Title" style="height: 190px; object-fit: cover;">
                        }
                        else
                        {
                            <div class="bg-light text-secondary text-center py-5" style="height: 190px;">
                                <i class="bi bi-play-circle display-4 opacity-50"></i>
                            </div>
                        }

                        <div class="card-body d-flex flex-column p-4">
                            <div class="d-flex align-items-center justify-content-between mb-2">
                                <span class="badge bg-primary-subtle text-primary border border-primary-subtle">@course.Category?.Name</span>
                                <span class="badge bg-success-subtle text-success border border-success-subtle">Ücretsiz</span>
                            </div>
                            
                            <h5 class="card-title fs-6 mb-2 text-dark fw-bold">@course.Title</h5>
                            <p class="card-text text-muted small mb-3 flex-grow-1" style="display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;">
                                @(string.IsNullOrEmpty(course.Description) ? "Açıklama belirtilmemiş." : course.Description)
                            </p>
                            
                            <div class="pt-3 border-top d-flex justify-content-between align-items-center mt-auto">
                                <span class="text-secondary small">
                                    <i class="bi bi-person me-1"></i>@course.Teacher?.FirstName @course.Teacher?.LastName
                                </span>
                                <a asp-controller="Course" asp-action="Details" asp-route-id="@course.Id" class="btn btn-sm btn-outline-primary rounded-pill px-3">
                                    İncele
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>