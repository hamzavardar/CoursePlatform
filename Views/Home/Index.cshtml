@model IEnumerable<CoursePlatform.Models.Course>

@{
    ViewData["Title"] = "Ana Sayfa";
}

<!-- Sadeleştirilmiş Hero Alanı -->
<div class="bg-white rounded-4 p-4 p-md-5 mb-5 border text-center shadow-sm">
    <div class="row justify-content-center py-3">
        <div class="col-lg-8">
            <span class="badge bg-primary-subtle text-primary mb-3 px-3 py-2 rounded-pill">Kolay ve Hızlı Öğrenim</span>
            <h1 class="display-5 fw-bold text-dark mb-3" style="letter-spacing: -1px;">Öğrenmeye ve Öğretmeye Hemen Başlayın</h1>
            <p class="text-secondary lead mb-4">
                Sade arayüzümüz sayesinde karmaşadan uzak durun. İster video yükleyip ders verin, ister hemen izlemeye başlayın.
            </p>
            <div class="d-flex justify-content-center gap-3">
                <a asp-controller="Course" asp-action="Index" class="btn btn-primary btn-lg px-4 fs-6">
                    Kurslara Göz At
                </a>
                @if (User.Identity != null && !User.Identity.IsAuthenticated)
                {
                    <a asp-area="Identity" asp-page="/Account/Register" class="btn btn-outline-primary btn-lg px-4 fs-6">
                        Hesap Oluştur
                    </a>
                }
            </div>
        </div>
    </div>
</div>

<!-- Öne Çıkan Kurslar -->
<div class="d-flex justify-content-between align-items-center mb-4">
    <h4 class="fw-bold mb-0 text-dark">Son Eklenen Kurslar</h4>
    <a asp-controller="Course" asp-action="Index" class="text-decoration-none fw-medium text-primary">Tümünü Gör &rarr;</a>
</div>

@if (!Model.Any())
{
    <div class="card p-5 text-center text-muted">
        Henüz eklenmiş bir kurs bulunmuyor.
    </div>
}
else
{
    <div class="row row-cols-1 row-cols-md-3 g-4">
        @foreach (var course in Model)
        {
            <div class="col">
                <div class="card h-100 border-0 shadow-sm overflow-hidden">
                    @if (!string.IsNullOrEmpty(course.CoverImageUrl))
                    {
                        <img src="@course.CoverImageUrl" class="card-img-top" alt="@course.Title" style="height: 180px; object-fit: cover;">
                    }
                    else
                    {
                        <div class="bg-light text-secondary text-center py-5" style="height: 180px;">
                            <i class="bi bi-play-circle display-4"></i>
                        </div>
                    }

                    <div class="card-body d-flex flex-column p-4">
                        <span class="badge bg-light text-secondary border w-auto mb-2 align-self-start">@course.Category?.Name</span>
                        <h5 class="card-title fs-6 mb-2">@course.Title</h5>
                        <p class="card-text text-muted small text-truncate mb-3">@course.Description</p>
                        
                        <div class="mt-auto pt-3 border-top d-flex justify-content-between align-items-center">
                            <span class="fw-bold text-dark">
                                @(course.Price == 0 ? "Ücretsiz" : course.Price.ToString("C2"))
                            </span>
                            <a asp-controller="Course" asp-action="Details" asp-route-id="@course.Id" class="btn btn-sm btn-outline-primary">
                                İncele
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}