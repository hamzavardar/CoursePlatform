@page
@model LoginModel

@{
    ViewData["Title"] = "Giriş Yap";
}

<div class="row justify-content-center py-4">
    <div class="col-md-5">
        <div class="card border-0 shadow-sm rounded-4 p-4 bg-white">
            <div class="text-center mb-4">
                <i class="bi bi-person-lock display-5 text-primary"></i>
                <h3 class="fw-bold text-dark mt-2">EduStream'e Giriş Yap</h3>
                <p class="text-secondary small">Kurslarınıza erişmek için bilgilerinizi giriniz.</p>
            </div>

            <form id="account" method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3" role="alert"></div>

                <div class="form-floating mb-3">
                    <input asp-for="Input.Email" class="form-control rounded-3" autocomplete="username" aria-required="true" placeholder="name@example.com" />
                    <label asp-for="Input.Email">E-Posta Adresi</label>
                    <span asp-validation-for="Input.Email" class="text-danger small"></span>
                </div>

                <div class="form-floating mb-3">
                    <input asp-for="Input.Password" class="form-control rounded-3" autocomplete="current-password" aria-required="true" placeholder="password" />
                    <label asp-for="Input.Password">Parola</label>
                    <span asp-validation-for="Input.Password" class="text-danger small"></span>
                </div>

                <div class="checkbox mb-3 d-flex justify-content-between align-items-center">
                    <label asp-for="Input.RememberMe" class="form-label mb-0 text-secondary small">
                        <input class="form-check-input me-1" asp-for="Input.RememberMe" />
                        Beni Hatırla
                    </label>
                </div>

                <button id="login-submit" type="submit" class="w-100 btn btn-primary btn-lg rounded-3 fs-6 fw-semibold mb-3">
                    Giriş Yap
                </button>

                <div class="text-center border-top pt-3">
                    <p class="small text-secondary mb-0">
                        Hesabınız yok mu? 
                        <a asp-page="./Register" asp-route-returnUrl="@Model.ReturnUrl" class="text-primary fw-medium text-decoration-none">Hemen Kaydolun</a>
                    </p>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}